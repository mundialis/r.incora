[flake8]

# E501 line too long (83 > 79 characters)
# F821 undefined name '_'

exclude = .git
max-line-length = 88
per-file-ignores =
    ./v.incora.training_data/v.incora.training_data.py: F821, E501, F824
    ./r.incora.postproc/r.incora.postproc.py: F821, F824
    ./r.incora.change/r.incora.change.py: F821, F824
